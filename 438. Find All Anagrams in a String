class Solution {
public:
    vector<int> findAnagrams(string s, string p) {
        if(p.size() > s.size()){
            return vector<int> {};
        }
        vector<int> res;
        unordered_map<char, int> smap, pmap;
        for(int i = 0; i < 26; i++){
            smap.insert({'a' + i, 0});
            pmap.insert({'a' + i, 0});
        } 
        for(char c: p){
            pmap[c]++;
        }
        for(int i = 0; i < s.size(); i++){
            smap[s[i]]++;
            if(i >= p.size()){
                smap[s[i - p.size()]]--;
            }
            if(smap == pmap){
                res.push_back(i + 1 - p.size());
            }
        }
        return res;
    }
};
