class MyQueue {
    stack<int> in;
    stack<int> out;
public:
    MyQueue() {
    }
    
    void push(int x) {
        in.push(x);
    }
    
    int pop() {
        if(out.empty()){
            while(!in.empty()){
                int t = in.top();
                in.pop();
                out.push(t);
            }
        }
        int t = out.top();
        out.pop();
        return t;
    }
    
    int peek() {
        if(out.empty()){
            while(!in.empty()){
                int t = in.top();
                in.pop();
                out.push(t);
            }
        }
        int t = out.top();
        return t;
    }
    
    bool empty() {
        return (in.empty() && out.empty()) ? true : false;
    }
};

