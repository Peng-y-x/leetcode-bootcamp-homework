class Solution {
public:
    vector<int> dailyTemperatures(vector<int>& temperatures) {
        int n = temperatures.size();
        stack<int> temp;
        vector<int> res(n, 0);
        temp.push(0);
        for(int i = 1; i < n; i++){
            int t = temperatures[i];
            while(!temp.empty() && temperatures[temp.top()] < t){
                res[temp.top()] = i - temp.top();
                temp.pop();
            }
            temp.push(i);
        }
        return res;
    }
};
