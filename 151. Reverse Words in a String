class Solution {
public:
    string reverseWords(string s) {
        vector<string> strings;
        string word = "", res = "";
        for(int i = 0; i < s.size(); i++){
            if(s[i] != ' '){
                word += s[i];
            }
            if(s[i] == ' ' || i == s.size() - 1)
            {
                if(word != ""){
                    strings.push_back(word);
                    word = "";
                }
            }
        }
        reverse(strings.begin(), strings.end());
        for(string w : strings){
            res += w;
            res += ' ';
        }
        res.pop_back();
        return res;
    }
};
